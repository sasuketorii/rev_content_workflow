{
  "formatVersion": 1,
  "name": "rev-content-workflow",
  "version": "0.1.0",
  "node": ">=22.13.0",
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-arm64",
    "linux-x64"
  ],
  "buildStrategy": "Source release verifies the pinned and post-patch NotebookLM package-lock before npm ci, then builds RevMagic from a hashed isolated three-crate Cargo.lock with cargo build --locked. Runtime artifacts are installed user-locally and are not committed.",
  "licenseGate": {
    "status": "PASS",
    "project": "MIT",
    "notebooklm": "MIT",
    "revmagic": "MIT"
  },
  "runtimeDataPolicy": {
    "repository": false,
    "releaseArchive": false,
    "userLocalOnly": [
      "credentials",
      "browser profiles",
      "SQLite databases",
      "audio",
      "transcripts"
    ]
  },
  "releaseAllowlist": [
    ".gitignore",
    ".github/workflows/linux-external-gate.yml",
    "LICENSE",
    "LICENSES/NotebookLM-MCP.txt",
    "LICENSES/RevMagic.txt",
    "README.md",
    "README.ja.md",
    "config.example.json",
    "distribution-manifest.json",
    "eslint.config.js",
    "install.sh",
    "locks/revmagic-isolated.Cargo.lock",
    "locks/notebooklm-patched.package-lock.json",
    "package-lock.json",
    "package.json",
    "packaging/systemd/rev-content.service.in",
    "packaging/systemd/rev-content.timer.in",
    "patches/notebooklm-audio-custom.patch",
    "patches/revmagic-optimize.patch",
    "scripts/build-release.sh",
    "scripts/generate-sbom.mjs",
    "scripts/hash-tree.mjs",
    "scripts/test-fixture-install.sh",
    "scripts/test-systemd-contract.sh",
    "scripts/test-workflow-pins.sh",
    "scripts/verify-distribution.sh",
    "scripts/verify-tree.mjs",
    "skills/rev-content/agents/openai.yaml",
    "skills/rev-content/SKILL.md",
    "src/cli.ts",
    "src/config.ts",
    "src/distribution-cli.ts",
    "src/distribution.ts",
    "src/engine.ts",
    "src/mcp.ts",
    "src/paths.ts",
    "src/registrations.ts",
    "src/store.ts",
    "src/types.ts",
    "src/util.ts",
    "test/distribution.test.ts",
    "test/fake-client.mjs",
    "test/fake-mcp.mjs",
    "test/fake-systemctl.mjs",
    "test/integration.test.ts",
    "test/preflight-mcp.mjs",
    "test/silent-mcp.mjs",
    "tsconfig.json",
    "upstream.lock.json"
  ]
}
