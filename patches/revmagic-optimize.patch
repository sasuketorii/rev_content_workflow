+  let stem = input.file_stem().and_then(|value| value.to_str()).filter(|value| !value.is_empty()).unwrap_or("audio");
+  let output = parent.join(format!("{stem}.mp3"));
+  let temporary = parent.join(format!(".{stem}.optimizing.mp3"));
+  let _ = fs::remove_file(&temporary);
+  let args = vec![OsString::from("-y"), OsString::from("-nostdin"), OsString::from("-i"), input.as_os_str().into(), OsString::from("-vn"), OsString::from("-map_metadata"), OsString::from("-1"), OsString::from("-c:a"), OsString::from("libmp3lame"), OsString::from("-b:a"), OsString::from(OPTIMIZED_MP3_BITRATE), OsString::from("-ar"), OsString::from(OPTIMIZED_MP3_SAMPLE_RATE), OsString::from("-ac"), OsString::from("1"), OsString::from("-threads"), OsString::from("1"), OsString::from("-progress"), OsString::from("pipe:1"), OsString::from("-nostats"), temporary.as_os_str().into()];
