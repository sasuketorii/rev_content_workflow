+assert.equal(selectionFailure.data.recovery, "active_selection_failed");
+assert.equal(selectionFailure.data.notebook_id, "already-registered");
+assert.match(selectionFailure.error, /select_notebook/);
+assert.match(selectionFailure.error, /do not call add_notebook again/);
+console.log("create_notebook selection recovery: PASS");
+
+const libraryFixtureRoot = await fs.mkdtemp(path.join(os.tmpdir(), "notebooklm-library-create-"));
+const writeFailurePath = path.join(libraryFixtureRoot, "write-failure.json");
+const writeSeed = new NotebookLibrary({ libraryPath: writeFailurePath });
+await writeSeed.listNotebooks();
+const writeFailure = new NotebookLibrary({
+  libraryPath: writeFailurePath,
+  writeFile: () => {
+    throw new Error("simulated write failure");
+  },
+});
+await assert.rejects(() =>
+  writeFailure.addNotebook({
+    url: "https://notebooklm.google.com/notebook/eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee",
+    name: "Write failure",
+    description: "test",
+    topics: ["test"],
+  })
+);
+assert.deepEqual(await writeFailure.listNotebooks(), []);
+assert.equal(await writeFailure.getActiveNotebook(), null);
+const existing = {
+  id: "existing",
+  url: "https://notebooklm.google.com/notebook/ffffffff-ffff-4fff-8fff-ffffffffffff",
+  name: "Existing",
+  description: "test",
+  topics: ["test"],
+  content_types: ["test"],
+  use_cases: ["test"],
+  added_at: "before",
+  last_used: "before",
+  use_count: 0,
+  tags: [],
+};
+const selectPath = path.join(libraryFixtureRoot, "select-failure.json");
+const selectSeed = new NotebookLibrary({ libraryPath: selectPath });
+await selectSeed.addNotebook({
+  url: existing.url,
+  name: existing.name,
+  description: existing.description,
+  topics: existing.topics,
+  content_types: existing.content_types,
+  use_cases: existing.use_cases,
+  tags: existing.tags,
+});
+const beforeSelect = await selectSeed.getActiveNotebook();
+const selectWriteFailure = new NotebookLibrary({
+  libraryPath: selectPath,
+  writeFile: () => {
+    throw new Error("simulated write failure");
+  },
+});
+await assert.rejects(() => selectWriteFailure.selectNotebook(beforeSelect.id));
+assert.equal((await selectWriteFailure.getActiveNotebook())?.id, beforeSelect.id);
+assert.equal((await selectWriteFailure.getNotebook(beforeSelect.id)).last_used, beforeSelect.last_used);
+const japaneseName = new NotebookLibrary({
+  libraryPath: path.join(libraryFixtureRoot, "japanese.json"),
+});
+const japanese = await japaneseName.addNotebook({
+  url: "https://notebooklm.google.com/notebook/11111111-1111-4111-8111-111111111111",
+  name: "日本語ノート",
+  description: "test",
+  topics: ["test"],
+});
+assert.equal(japanese.id, "notebook");
+assert.equal((await japaneseName.getActiveNotebook())?.id, "notebook");
+await fs.rm(libraryFixtureRoot, { recursive: true, force: true });
+console.log("library transactional write and Japanese-name ID tests: PASS");
