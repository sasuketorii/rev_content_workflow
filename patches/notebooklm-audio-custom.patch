index 0000000..cdf0733
--- /dev/null
+++ b/scripts/test-library-concurrency.mjs
@@ -0,0 +1,216 @@
+#!/usr/bin/env node
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import fsp from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { spawn } from "node:child_process";
+import { NotebookLibrary } from "../dist/library/notebook-library.js";
+
+const [, , mode, libraryPath, prefix] = process.argv;
+
+if (mode === "--worker") {
+  const library = new NotebookLibrary({ libraryPath });
+  for (let index = 0; index < 12; index += 1) {
+    const entry = await library.addNotebook({
+      url: `https://notebooklm.google.com/notebook/${prefix === "a" ? "aaaaaaaa" : "bbbbbbbb"}-${String(index).padStart(4, "0")}-4000-8000-000000000000`,
+      name: `${prefix}-${index}`,
+      description: "concurrency fixture",
+      topics: ["initial"],
+    });
+    await library.updateNotebook({ id: entry.id, topics: ["updated", prefix] });
+  }
+  process.exit(0);
+}
+
+if (mode === "--heartbeat-holder") {
+  const marker = prefix;
+  const library = new NotebookLibrary({
+    libraryPath,
+    lockStaleMs: 5000,
+    lockUpdateMs: 1000,
+    writeFile: async (target, data) => {
+      await fsp.writeFile(marker, "locked");
+      await new Promise((resolve) => setTimeout(resolve, 7000));
+      await fsp.writeFile(target, data);
+    },
+  });
+  await library.addNotebook({
+    url: "https://notebooklm.google.com/notebook/dddddddd-dddd-4ddd-8ddd-dddddddddddd",
+    name: "heartbeat-holder",
+    description: "heartbeat fixture",
+    topics: ["heartbeat"],
+  });
+  process.exit(0);
+}
+
+if (mode === "--heartbeat-contender") {
+  const library = new NotebookLibrary({
+    libraryPath,
+    lockStaleMs: 5000,
+    lockUpdateMs: 1000,
+  });
+  await library.addNotebook({
+    url: "https://notebooklm.google.com/notebook/eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee",
+    name: "heartbeat-contender",
+    description: "heartbeat fixture",
+    topics: ["heartbeat"],
+  });
+  process.exit(0);
+}
+
+const root = await fsp.mkdtemp(path.join(os.tmpdir(), "notebooklm-library-concurrency-"));
+const sharedPath = path.join(root, "library.json");
+const observer = new NotebookLibrary({ libraryPath: sharedPath });
+assert.deepEqual(await observer.listNotebooks(), []);
+
+const runWorker = (workerPrefix) =>
+  new Promise((resolve, reject) => {
+    const child = spawn(process.execPath, [import.meta.filename, "--worker", sharedPath, workerPrefix], {
+      stdio: ["ignore", "pipe", "pipe"],
+    });
+    let stderr = "";
+    child.stderr.on("data", (chunk) => {
+      stderr += chunk;
+    });
+    child.on("error", reject);
+    child.on("exit", (code) =>
+      code === 0 ? resolve() : reject(new Error(`worker ${workerPrefix} failed (${code}): ${stderr}`))
+    );
+  });
+
+await Promise.all([runWorker("a"), runWorker("b")]);
+const parsed = JSON.parse(await fsp.readFile(sharedPath, "utf-8"));
+assert.equal(parsed.notebooks.length, 24);
+assert.ok(parsed.revision >= 49);
+assert.equal(new Set(parsed.notebooks.map((entry) => entry.id)).size, 24);
+assert.ok(parsed.notebooks.every((entry) => entry.topics[0] === "updated"));
+
+// The instance created before child writes must observe external revisions.
+const refreshed = await observer.listNotebooks();
+assert.equal(refreshed.length, 24);
+const metadata = await observer.getMetadata();
+assert.equal(metadata.revision, parsed.revision);
+assert.equal(metadata.stale, false);
+assert.equal(metadata.external_change_detected, true);
+
+// A failed temp write must preserve the authoritative old file byte-for-byte.
+const beforeFailure = await fsp.readFile(sharedPath);
+const failing = new NotebookLibrary({
+  libraryPath: sharedPath,
+  writeFile: () => {
+    throw new Error("injected temp write failure");
+  },
+});
+await assert.rejects(
+  () =>
+    failing.addNotebook({
+      url: "https://notebooklm.google.com/notebook/cccccccc-cccc-4ccc-8ccc-cccccccccccc",
+      name: "must-not-commit",
+      description: "failure fixture",
+      topics: ["failure"],
+    }),
+  /library_write_failed/
+);
+assert.deepEqual(await fsp.readFile(sharedPath), beforeFailure);
+JSON.parse(await fsp.readFile(sharedPath, "utf-8"));
+
+// Invalid mutation shapes and overflowing counters fail before commit. The
+// authoritative bytes and revision must remain unchanged.
+const mutationGuard = new NotebookLibrary({ libraryPath: sharedPath });
+const mutationBytes = await fsp.readFile(sharedPath);
+const mutationRevision = JSON.parse(mutationBytes).revision;
+await assert.rejects(
+  mutationGuard.addNotebook({
+    url: "https://notebooklm.google.com/notebook/ffffffff-ffff-4fff-8fff-ffffffffffff",
+    name: "invalid-description",
+    description: 42,
+    topics: ["guard"],
+  }),
+  /description must be a string/
+);
+await assert.rejects(
+  mutationGuard.updateNotebook({
+    id: parsed.notebooks[0].id,
+    name: 42,
+  }),
+  /name must be a string/
+);
+assert.deepEqual(await fsp.readFile(sharedPath), mutationBytes);
+assert.equal(JSON.parse(await fsp.readFile(sharedPath, "utf-8")).revision, mutationRevision);
+
+const maxSafePath = path.join(root, "max-safe.json");
+const maxSafeLibrary = {
+  notebooks: [
+    {
+      ...parsed.notebooks[0],
+      id: "max-safe",
+      use_count: Number.MAX_SAFE_INTEGER,
+    },
+  ],
+  active_notebook_id: "max-safe",
+  last_modified: new Date().toISOString(),
+  version: "1.0.0",
+  revision: 1,
+};
+await fsp.writeFile(maxSafePath, JSON.stringify(maxSafeLibrary), { mode: 0o600 });
+const maxSafeBytes = await fsp.readFile(maxSafePath);
+const maxSafe = new NotebookLibrary({ libraryPath: maxSafePath });
+await assert.rejects(
+  maxSafe.incrementUseCount("max-safe"),
+  /MAX_SAFE_INTEGER/
+);
+assert.deepEqual(await fsp.readFile(maxSafePath), maxSafeBytes);
+
+// Invalid JSON is preserved and startup fails closed instead of resetting it.
+const corruptPath = path.join(root, "corrupt.json");
+await fsp.writeFile(corruptPath, "{not-json", { mode: 0o600 });
+let corruptError;
+assert.throws(
+  () => new NotebookLibrary({ libraryPath: corruptPath }),
+  (error) => {
+    corruptError = error;
+    return /library_invalid/.test(error.message);
+  }
+);
+assert.equal(await fsp.readFile(corruptPath, "utf-8"), "{not-json");
+const backups = (await fsp.readdir(root)).filter((name) => name.startsWith("corrupt.json.corrupt-"));
+assert.equal(backups.length, 1);
+assert.match(corruptError.message, new RegExp(`backup=${backups[0].replaceAll(".", "\\.")}`));
+assert.equal(fs.statSync(path.join(root, backups[0])).mode & 0o777, 0o600);
+
+// An active writer awaiting async I/O must keep its proper-lockfile heartbeat;
+// a contender must wait rather than reclaiming the lock as stale.
+const heartbeatPath = path.join(root, "heartbeat.json");
+const heartbeatSeed = new NotebookLibrary({ libraryPath: heartbeatPath });
+await heartbeatSeed.listNotebooks();
+const markerPath = path.join(root, "holder.locked");
+const spawnMode = (workerMode, extra = "") =>
+  spawn(process.execPath, [import.meta.filename, workerMode, heartbeatPath, extra], {
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+const holder = spawnMode("--heartbeat-holder", markerPath);
+for (let attempt = 0; attempt < 100 && !fs.existsSync(markerPath); attempt += 1)
+  await new Promise((resolve) => setTimeout(resolve, 50));
+assert.equal(fs.existsSync(markerPath), true);
+const contender = spawnMode("--heartbeat-contender");
+const waitChild = (child, label) =>
+  new Promise((resolve, reject) => {
+    let stderr = "";
+    child.stderr.on("data", (chunk) => {
+      stderr += chunk;
+    });
+    child.on("error", reject);
+    child.on("exit", (code) =>
+      code === 0 ? resolve() : reject(new Error(`${label} failed (${code}): ${stderr}`))
+    );
+  });
+await Promise.all([waitChild(holder, "holder"), waitChild(contender, "contender")]);
+const heartbeatFinal = JSON.parse(await fsp.readFile(heartbeatPath, "utf-8"));
+assert.deepEqual(
+  new Set(heartbeatFinal.notebooks.map((entry) => entry.name)),
+  new Set(["heartbeat-holder", "heartbeat-contender"])
+);
+
+await fsp.rm(root, { recursive: true, force: true });
+console.log("library cross-process concurrency and durability tests: PASS");
