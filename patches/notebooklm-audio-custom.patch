@@ -0,0 +1,191 @@
+import type { Page } from "patchright";
+import { assertNotebookLmUrl } from "./notebook-url.js";
+import { Selectors } from "./selectors.js";
+import { safeSleep } from "../browser/watchdog.js";
+
+const HOME_URL = "https://notebooklm.google.com/";
+const DEFAULT_TIMEOUT_MS = 60_000;
+const MIN_TIMEOUT_MS = 5_000;
+const MAX_TIMEOUT_MS = 120_000;
+
+export interface CreateNotebookBrowserInput {
+  timeoutMs?: number;
+}
+
+export interface CreateNotebookBrowserResult {
+  url: string;
+  sourceModalClosed: boolean;
+}
+
+export function resolveCreateNotebookTimeout(value?: number): number {
+  if (value === undefined) return DEFAULT_TIMEOUT_MS;
+  if (!Number.isInteger(value) || value < MIN_TIMEOUT_MS || value > MAX_TIMEOUT_MS)
+    throw new Error(
+      `timeout_ms must be an integer between ${MIN_TIMEOUT_MS} and ${MAX_TIMEOUT_MS}.`
+    );
+  return value;
+}
+
+/**
+ * Create a notebook only through the official NotebookLM home-page UI.
+ * A successful click is never enough: a strict notebook UUID URL is the
+ * confirmation signal, so login pages, stale home pages, and UI drift fail
+ * closed without returning a target that source tools could bind to.
+ */
+export async function createNotebook(
+  page: Page,
+  input: CreateNotebookBrowserInput = {}
+): Promise<CreateNotebookBrowserResult> {
+  const timeoutMs = resolveCreateNotebookTimeout(input.timeoutMs);
+  const deadline = Date.now() + timeoutMs;
+  await page.goto(HOME_URL, {
+    waitUntil: "domcontentloaded",
+    timeout: remainingMs(deadline),
+  });
+
+  let lastUrl = page.url();
+  assertNotebookLmHomepageUrl(lastUrl);
+  const createButton = page.locator(Selectors.home.createNotebook.join(", ")).first();
+  while (Date.now() < deadline) {
+    lastUrl = page.url();
+    assertNotebookLmHomepageUrl(lastUrl);
+    if (await prepareHomepageForCreate(page, deadline)) continue;
+    // A combined selector gives each poll one bounded visibility probe rather
+    // than multiplying the timeout by every fallback selector.
+    if (
+      await createButton
+        .isVisible({ timeout: Math.min(200, remainingMs(deadline)) })
+        .catch(() => false)
+    ) {
+      try {
+        await createButton.click({ timeout: Math.min(5_000, remainingMs(deadline)) });
+        break;
+      } catch (error) {
+        // A rebrand dialog can mount after the gate but before Patchright
+        // dispatches the click. Re-enter only the verified dialog path; any
+        // other overlay remains fail-closed.
+        if (isOverlayInterception(error) && (await prepareHomepageForCreate(page, deadline)))
+          continue;
+        throw error;
+      }
+    }
+    await safeSleep(page, Math.min(250, remainingMs(deadline)));
+  }
+  if (Date.now() >= deadline && !assertNotebookLmUrlOrNull(page.url()))
+    throw new Error(
+      "NotebookLM create-notebook control did not appear before timeout; UI may have changed."
+    );
+
+  while (Date.now() < deadline) {
+    lastUrl = page.url();
+    try {
+      const url = assertNotebookLmUrl(lastUrl);
+      return { url, sourceModalClosed: await closeInitialSourceModal(page, deadline) };
+    } catch {
+      await safeSleep(page, 250);
+    }
+  }
+  throw new Error("Notebook creation did not reach a valid NotebookLM UUID URL before timeout.");
+}
+
+async function prepareHomepageForCreate(page: Page, deadline: number): Promise<boolean> {
+  const dismissed = await dismissKnownRebrandEducationDialog(page, deadline);
+  await assertNoUnexpectedHomepageDialog(page, deadline);
+  return dismissed;
+}
+
+/**
+ * NotebookLM currently shows this one-time education dialog to authenticated
+ * users. Its component, copy, and dedicated dismiss control are all checked
+ * before interaction; no generic dialog dismissal is permitted.
+ */
+async function dismissKnownRebrandEducationDialog(page: Page, deadline: number): Promise<boolean> {
+  const dialog = page.locator("rebrand-education-dialog").first();
+  if (
+    !(await dialog.isVisible({ timeout: Math.min(250, remainingMs(deadline)) }).catch(() => false))
+  )
+    return false;
+  const text =
+    (await dialog
+      .textContent({ timeout: Math.min(1_000, remainingMs(deadline)) })
+      .catch(() => "")) ?? "";
+  if (!text.includes("NotebookLM") || !text.includes("Gemini Notebook"))
+    throw new Error("Unexpected rebrand education dialog content; refusing to dismiss it.");
+  const dismiss = dialog.locator("button.dismiss-button").first();
+  if (
+    !(await dismiss
+      .isVisible({ timeout: Math.min(1_000, remainingMs(deadline)) })
+      .catch(() => false))
+  )
+    throw new Error("Known rebrand education dialog has no visible dismiss control.");
+  await dismiss.click({ timeout: Math.min(5_000, remainingMs(deadline)) });
+  await dialog.waitFor({ state: "hidden", timeout: Math.min(5_000, remainingMs(deadline)) });
+  return true;
+}
+
+/** A visible dialog other than the verified rebrand dialog must not be bypassed. */
+async function assertNoUnexpectedHomepageDialog(page: Page, deadline: number): Promise<void> {
+  const dialog = page.locator('[role="dialog"]').first();
+  if (await dialog.isVisible({ timeout: Math.min(250, remainingMs(deadline)) }).catch(() => false))
+    throw new Error("Unexpected homepage dialog is visible; refusing to click create_notebook.");
+}
+
+function isOverlayInterception(error: unknown): boolean {
+  const message = error instanceof Error ? error.message : String(error);
+  return /intercept(?:ed|s)?.*(?:pointer|click)|(?:pointer|click).*intercept/i.test(message);
+}
+
+function assertNotebookLmHomepageUrl(value: string): void {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new Error("NotebookLM homepage navigation produced an invalid URL.");
+  }
+  if (
+    url.protocol !== "https:" ||
+    url.hostname !== "notebooklm.google.com" ||
+    url.port !== "" ||
+    url.username !== "" ||
+    url.password !== "" ||
+    url.pathname !== "/"
+  )
+    throw new Error("NotebookLM homepage navigation redirected unexpectedly.");
+}
+
+function assertNotebookLmUrlOrNull(value: string): boolean {
+  try {
+    assertNotebookLmUrl(value);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Close only the initial source-picker modal, never an arbitrary dialog. */
+async function closeInitialSourceModal(page: Page, deadline: number): Promise<boolean> {
+  const dialog = page.locator(Selectors.sources.overlayPane).first();
+  if (
+    !(await dialog.isVisible({ timeout: Math.min(500, remainingMs(deadline)) }).catch(() => false))
+  )
+    return false;
+  const looksLikeSourceModal = await dialog
+    .locator('input[type="file"], textarea, button.drop-zone-icon-button')
+    .count()
+    .then((count) => count > 0)
+    .catch(() => false);
+  if (!looksLikeSourceModal) return false;
+  await page.keyboard.press("Escape");
+  await dialog
+    .waitFor({ state: "hidden", timeout: Math.min(5_000, remainingMs(deadline)) })
+    .catch(() => undefined);
+  return !(await dialog
+    .isVisible({ timeout: Math.min(250, remainingMs(deadline)) })
+    .catch(() => true));
+}
+
+function remainingMs(deadline: number): number {
+  const remaining = deadline - Date.now();
+  if (remaining <= 0) throw new Error("create_notebook deadline exceeded");
+  return remaining;
+}
