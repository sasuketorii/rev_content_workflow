+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import {
+  createNotebook,
+  resolveCreateNotebookTimeout,
+} from "../dist/notebooklm/create-notebook.js";
+import { ToolHandlers } from "../dist/tools/handlers.js";
+import { buildToolDefinitions } from "../dist/tools/definitions.js";
+import { SettingsManager } from "../dist/utils/settings-manager.js";
+import { NotebookLibrary } from "../dist/library/notebook-library.js";
+
+assert.equal(resolveCreateNotebookTimeout(), 60_000);
+assert.throws(() => resolveCreateNotebookTimeout(4_999));
+assert.throws(() => resolveCreateNotebookTimeout(120_001));
+
+const state = {
+  url: "https://notebooklm.google.com/",
+  createClicked: false,
+  sourceModalVisible: false,
+  escapePressed: false,
+};
+const page = {
+  async goto(url) {
+    state.url = url;
+  },
+  url: () => state.url,
+  locator(selector) {
+    // Current authenticated homepage DOM: <button class="create-new-button"
+    // aria-label="ノートブックを新規作成"><mat-icon>add</mat-icon>新規作成</button>.
+    const isCreate = selector.includes("create-new-button");
+    const isDialog = selector === '[role="dialog"]';
+    return {
+      first() {
+        return this;
+      },
+      async isVisible() {
+        return isCreate || (isDialog && state.sourceModalVisible);
+      },
+      async click() {
+        if (!isCreate) throw new Error("unexpected click");
+        state.createClicked = true;
+        state.url = "https://notebooklm.google.com/notebook/aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee";
+        state.sourceModalVisible = true;
+      },
+      locator() {
+        return {
+          async count() {
+            return 1;
+          },
+        };
+      },
+      async waitFor({ state: expected }) {
+        assert.equal(expected, "hidden");
+        assert.equal(state.sourceModalVisible, false);
+      },
+    };
+  },
+  keyboard: {
+    async press(key) {
+      assert.equal(key, "Escape");
+      state.escapePressed = true;
+      state.sourceModalVisible = false;
+    },
+  },
+};
+const created = await createNotebook(page, { timeoutMs: 5_000 });
+assert.equal(state.createClicked, true);
+assert.equal(created.url, "https://notebooklm.google.com/notebook/aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee");
+assert.equal(created.sourceModalClosed, true);
+assert.equal(state.escapePressed, true);
+console.log("create_notebook mocked homepage flow: PASS");
+
+const rebrandState = {
+  url: "https://notebooklm.google.com/",
+  rebrandVisible: true,
+  rebrandDismissed: false,
+  createClicked: false,
+};
+const rebrandPage = {
+  async goto(url) {
+    rebrandState.url = url;
+  },
+  url: () => rebrandState.url,
+  locator(selector) {
+    const isRebrand = selector === "rebrand-education-dialog";
+    const isCreate = selector.includes("create-new-button");
+    return {
+      first() {
+        return this;
+      },
+      async isVisible() {
+        return (isRebrand && rebrandState.rebrandVisible) || (isCreate && !rebrandState.rebrandVisible);
+      },
+      async textContent() {
+        return "NotebookLM は Gemini Notebook になりました。新しい名前の同じサービスです。詳細";
+      },
+      locator(child) {
+        assert.equal(child, "button.dismiss-button");
+        return {
+          first() { return this; },
+          async isVisible() { return rebrandState.rebrandVisible; },
+          async click() {
+            rebrandState.rebrandVisible = false;
+            rebrandState.rebrandDismissed = true;
+          },
+        };
+      },
+      async click() {
+        assert.equal(isCreate, true);
+        rebrandState.createClicked = true;
+        rebrandState.url = "https://notebooklm.google.com/notebook/acacacac-acac-4cac-8cac-acacacacacac";
+      },
+      async waitFor({ state: expected }) {
+        assert.equal(expected, "hidden");
+        assert.equal(rebrandState.rebrandVisible, false);
+      },
+    };
+  },
+  keyboard: { async press() { throw new Error("Escape must not be used"); } },
+};
+await createNotebook(rebrandPage, { timeoutMs: 5_000 });
+assert.equal(rebrandState.rebrandDismissed, true);
+assert.equal(rebrandState.createClicked, true);
+console.log("create_notebook known rebrand dialog dismissal: PASS");
+
+const delayedRebrandState = {
+  url: "https://notebooklm.google.com/",
+  rebrandVisible: false,
+  createChecks: 0,
+  dismissed: false,
+  clicked: false,
+};
+const delayedRebrandPage = {
+  async goto(url) { delayedRebrandState.url = url; },
+  url: () => delayedRebrandState.url,
+  locator(selector) {
+    const isRebrand = selector === "rebrand-education-dialog";
+    const isCreate = selector.includes("create-new-button");
+    return {
+      first() { return this; },
+      async isVisible() {
+        if (isRebrand) return delayedRebrandState.rebrandVisible;
+        if (!isCreate) return false;
+        delayedRebrandState.createChecks += 1;
+        if (delayedRebrandState.createChecks === 1) {
+          delayedRebrandState.rebrandVisible = true;
+          return false;
+        }
+        return !delayedRebrandState.rebrandVisible;
+      },
+      async textContent() { return "NotebookLM は Gemini Notebook になりました。新しい名前の同じサービスです。詳細"; },
+      locator() {
+        return {
+          first() { return this; },
+          async isVisible() { return delayedRebrandState.rebrandVisible; },
+          async click() {
+            delayedRebrandState.rebrandVisible = false;
+            delayedRebrandState.dismissed = true;
+          },
+        };
+      },
+      async click() {
+        delayedRebrandState.clicked = true;
+        delayedRebrandState.url = "https://notebooklm.google.com/notebook/adadadad-adad-4dad-8dad-adadadadadad";
+      },
+      async waitFor() {},
+    };
+  },
+  keyboard: { async press() { throw new Error("Escape must not be used"); } },
+};
+await createNotebook(delayedRebrandPage, { timeoutMs: 5_000 });
+assert.equal(delayedRebrandState.dismissed, true);
+assert.equal(delayedRebrandState.clicked, true);
+console.log("create_notebook delayed rebrand dialog dismissal: PASS");
+
+const interceptionState = {
+  url: "https://notebooklm.google.com/",
+  rebrandVisible: false,
+  clicks: 0,
+  dismissed: false,
+};
+const interceptionPage = {
+  async goto(url) { interceptionState.url = url; },
+  url: () => interceptionState.url,
+  locator(selector) {
+    const isRebrand = selector === "rebrand-education-dialog";
+    const isCreate = selector.includes("create-new-button");
+    return {
+      first() { return this; },
+      async isVisible() { return isRebrand ? interceptionState.rebrandVisible : isCreate; },
+      async textContent() { return "NotebookLM は Gemini Notebook になりました。新しい名前の同じサービスです。詳細"; },
+      locator() {
+        return {
+          first() { return this; },
+          async isVisible() { return interceptionState.rebrandVisible; },
+          async click() {
+            interceptionState.rebrandVisible = false;
+            interceptionState.dismissed = true;
+          },
+        };
+      },
+      async click() {
+        interceptionState.clicks += 1;
+        if (interceptionState.clicks === 1) {
+          interceptionState.rebrandVisible = true;
+          throw new Error("rebrand dialog intercepts pointer events");
+        }
+        interceptionState.url = "https://notebooklm.google.com/notebook/aeaeaeae-aeae-4eae-8eae-aeaeaeaeaeae";
+      },
+      async waitFor() {},
+    };
+  },
+  keyboard: { async press() { throw new Error("Escape must not be used"); } },
+};
+await createNotebook(interceptionPage, { timeoutMs: 5_000 });
+assert.equal(interceptionState.dismissed, true);
+assert.equal(interceptionState.clicks, 2);
+console.log("create_notebook intercepted click rebrand recovery: PASS");
+
+let unknownOverlayCreateClicks = 0;
+const unknownOverlayPage = {
+  async goto() {},
+  url: () => "https://notebooklm.google.com/",
+  locator(selector) {
+    const isCreate = selector.includes("create-new-button");
+    return {
+      first() { return this; },
+      async isVisible() { return selector === '[role="dialog"]' || isCreate; },
+      async click() { if (isCreate) unknownOverlayCreateClicks += 1; },
+    };
+  },
+};
+await assert.rejects(
+  () => createNotebook(unknownOverlayPage, { timeoutMs: 5_000 }),
+  /Unexpected homepage dialog/
+);
+assert.equal(unknownOverlayCreateClicks, 0);
+console.log("create_notebook unknown overlay fail-closed: PASS");
+
+let delayedVisibilityChecks = 0;
+const delayedState = { url: "https://notebooklm.google.com/", clicked: false };
+const delayedPage = {
+  async goto(url) {
+    delayedState.url = url;
+  },
+  url: () => delayedState.url,
+  locator(selector) {
+    const isCreate = selector.includes("create-new-button");
+    return {
+      first() {
+        return this;
+      },
+      async isVisible() {
+        return isCreate && ++delayedVisibilityChecks >= 3;
+      },
+      async click() {
+        delayedState.clicked = true;
+        delayedState.url = "https://notebooklm.google.com/notebook/abababab-abab-4bab-8bab-abababababab";
+      },
+      locator() {
+        return { async count() { return 0; } };
+      },
+      async waitFor() {},
+    };
+  },
+  keyboard: { async press() {} },
+};
+const delayedCreated = await createNotebook(delayedPage, { timeoutMs: 5_000 });
+assert.equal(delayedState.clicked, true);
+assert.ok(delayedVisibilityChecks >= 3);
+assert.match(delayedCreated.url, /abababab-abab-4bab-8bab-abababababab/);
+console.log("create_notebook delayed homepage control: PASS");
+
+const redirectedPage = {
+  async goto() {},
+  url: () => "https://accounts.google.com/signin",
+  locator() {
+    throw new Error("must not inspect controls after redirect");
+  },
+};
+await assert.rejects(
+  () => createNotebook(redirectedPage, { timeoutMs: 5_000 }),
+  /redirected unexpectedly/
+);
+console.log("create_notebook login redirect fail-closed: PASS");
+
+const tools = new Map(buildToolDefinitions({ getActiveNotebook: () => null }).map((tool) => [tool.name, tool]));
+const definition = tools.get("create_notebook");
+assert.ok(definition, "create_notebook is registered");
+assert.equal(definition.annotations.readOnlyHint, false);
+assert.equal(definition.annotations.destructiveHint, false);
+assert.equal(definition.annotations.idempotentHint, false);
+assert.equal(definition.inputSchema.properties.timeout_ms.minimum, 5_000);
+
+const priorProfile = process.env.NOTEBOOKLM_PROFILE;
+process.env.NOTEBOOKLM_PROFILE = "standard";
+try {
+  const filtered = new SettingsManager().filterTools(
+    buildToolDefinitions({ getActiveNotebook: () => null })
+  );
+  assert.ok(filtered.some((tool) => tool.name === "create_notebook"));
+} finally {
+  if (priorProfile === undefined) delete process.env.NOTEBOOKLM_PROFILE;
+  else process.env.NOTEBOOKLM_PROFILE = priorProfile;
+}
+console.log("create_notebook standard profile exposure: PASS");
+
+const entries = [];
+const library = {
+  addNotebook(input) {
+    const entry = { id: `nb-${entries.length + 1}`, ...input };
+    entries.push(entry);
+    return entry;
+  },
+  selectNotebook(id) {
+    return entries.find((entry) => entry.id === id);
+  },
+};
+const handlers = new ToolHandlers({}, {}, library, {
