+assert.match(result.data.notebook.name, /^New Notebook /);
+assert.deepEqual(result.data.notebook.tags, ["new"]);
+assert.equal(result.data.source_modal_closed, true);
+console.log("create_notebook handler library registration: PASS");
+
+const failingHandlers = new ToolHandlers({}, {}, { addNotebook() { throw new Error("disk unavailable"); } }, {
+  createNotebookInBrowser: async () => ({
+    url: "https://notebooklm.google.com/notebook/cccccccc-cccc-4ccc-8ccc-cccccccccccc",
+    sourceModalClosed: false,
+  }),
+});
+const orphan = await failingHandlers.handleCreateNotebook({ name: "Recovery" });
+assert.equal(orphan.success, false);
+assert.match(orphan.error, /cccccccc-cccc-4ccc-8ccc-cccccccccccc/);
+assert.match(orphan.error, /add_notebook/);
+assert.equal(orphan.data.recovery, "library_registration_failed");
+assert.match(orphan.data.notebook_url, /cccccccc-cccc-4ccc-8ccc-cccccccccccc/);
+console.log("create_notebook orphan recovery: PASS");
+
+const selectionHandlers = new ToolHandlers(
